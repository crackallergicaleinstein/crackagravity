# ---- never publish -------------------------------------------------------
# Captured request/response traffic from the local MITM run. Contains live
# `Authorization: Bearer ya29…` values and refresh tokens.
mitm/dumps/

# Local CA and leaf material generated by mitm/proxy.mjs
mitm/ca.key
mitm/ca.srl
mitm/leaf.key
mitm/leaf.csr
mitm/leaf.crt
mitm/ca.crt

# Runtime state: local API keys, OAuth token cache, account pool
*.token.json
apikeys.json
accounts.json
accounts-tokens.json
token.json
credentials.json

